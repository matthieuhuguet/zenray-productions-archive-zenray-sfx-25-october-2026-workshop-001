# 26 October 2026: opening image of the ZenRay SFX article. One sound (Denied), three signatures on the same scale:
# reference, reproduction from the recipe alone, semantic edit "Plus lourd". FR : image d'ouverture de l'article.
import sys, json
from pathlib import Path
REPO = Path("/Users/zenray/Create/Build/Productions/GithubProductions/ZenRaySFX")
sys.path.insert(0, str(REPO)); sys.path.insert(0, str(REPO / "Scripts"))
import numpy as np, soundfile as sf
from PIL import Image, ImageDraw, ImageFont
from ListenSheet import spec_img, FONTS
from zrsfx import semantic as SM
SOUND, OUT = "12-Denied", Path(__file__).resolve().parents[1] / "Drafts/Article/assets/hero-zenray-sfx-26-October-2026.png"
x, sr = sf.read(REPO / "refs" / f"{SOUND}.wav")
r = json.load(open(REPO / "out/repro-03" / f"{SOUND}.recipe.json")); m = SM.build(r)
low = [c for c in m["components"] if c["kind"] == "low"]; tone = sorted([c for c in m["components"] if c["kind"] == "tone"], key=lambda c: -c["desc"]["share"])
edits = {}
if low: edits[str(low[0]["index"])] = {"levelDb": 4}
if tone: edits[str(tone[0]["index"])] = {"pitchSt": -3}
panels = [("Référence", x), ("Reproduction depuis la recette", SM.render(m, {}, 7)), ("Retouche sémantique : plus lourd", SM.render(m, edits, 7))]
# Stacked rows: the article frames its opening image almost square (26 October 2026). / bandes empilées, cadre presque carré.
W, H, PAD, LABEL = 900, 250, 18, 40
img = Image.new("RGB", (W + 2 * PAD, 3 * (H + LABEL) + PAD), (246, 245, 242)); d = ImageDraw.Draw(img)
f = ImageFont.truetype(str(FONTS / "InterVariable.ttf"), 26)
for i, (label, y) in enumerate(panels):
    y0 = PAD + i * (H + LABEL)
    d.text((PAD, y0), label, fill=(29, 28, 26), font=f); img.paste(spec_img(y, sr).resize((W, H)), (PAD, y0 + LABEL - 4))
img.save(OUT); print(OUT)
